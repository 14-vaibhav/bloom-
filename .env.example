# Matches the Postgres container in docker-compose.yml (`docker compose up -d postgres`)
DATABASE_URL=postgres://bloom:bloom@localhost:5433/bloom
PORT=4000

# Optional for the seeded demo. Required for the cited Tutor, ingestion and question generation.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

LLM_ENABLED=false
CHAOS_MODE=false

# Security. Auth is off by default for the local demo; turn it on for anything shared.
AUTH_REQUIRED=false
# 32+ random characters, e.g. `openssl rand -hex 32`. Required when AUTH_REQUIRED=true.
AUTH_SECRET=
# Comma-separated browser origins allowed to call the API. Unset = localhost / 127.0.0.1 only.
CORS_ORIGINS=
RATE_LIMIT_TUTOR_PER_MIN=20
RATE_LIMIT_AGENT_PER_MIN=30
