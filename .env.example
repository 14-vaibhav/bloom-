# Postgres (local Homebrew: postgres://<your-mac-username>@localhost:5432/bloom — no password needed for trust-auth local connections)
# Postgres (docker-compose): postgres://bloom:bloom@localhost:5432/bloom
DATABASE_URL=postgres://localhost:5432/bloom

PORT=4000

# Required for scripts/generate-questions.ts and scripts/embed-resources.ts (offline only, not called at runtime)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Toggle at runtime once agent phases exist; Phase 1 makes zero LLM calls regardless
LLM_ENABLED=false

# Phase 7: which provider structuredCompletion() uses, and its runtime knobs
LLM_PROVIDER=gemini
LLM_TIMEOUT_MS=8000
LLM_CACHE_ENABLED=true

# Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5
ANTHROPIC_STRATEGIST_MODEL=claude-sonnet-4-5

CHAOS_MODE=false
