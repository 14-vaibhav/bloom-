{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate:generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "seed": "tsx src/db/seed/index.ts",
    "seed:reset": "tsx src/db/seed/index.ts --reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tools": "vitest run test/tools",
    "generate:questions": "tsx src/scripts/generate-questions.ts",
    "mark:reviewed": "tsx src/scripts/mark-reviewed.ts",
    "embed:resources": "tsx src/scripts/embed-resources.ts",
    "check:links": "tsx src/scripts/check-links.ts",
    "tools:smoke": "tsx src/scripts/tools-smoke.ts",
    "ingest:video": "tsx src/scripts/ingest-video.ts",
    "ingest:slides": "tsx src/scripts/ingest-slides.ts",
    "ingest:textbook": "tsx src/scripts/ingest-textbook.ts",
    "kb:segments": "tsx src/scripts/build-segments.ts",
    "kb:report": "tsx src/scripts/kb-report.ts",
    "kb:tune-tau": "tsx src/scripts/kb-tune-tau.ts",
    "eval": "tsx src/scripts/run-eval.ts",
    "eval:kb": "tsx src/eval/kb/runner.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.28.1",
    "fast-check": "^4.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}